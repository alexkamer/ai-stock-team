# Copy to .env and fill in your own values. .env is gitignored - never commit it.

# --- AWS Bedrock (for Claude) ---
# Only needed if you're not already relying on ambient AWS SSO/shared-credentials-file auth.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- App auth/session ---
# DATABASE_URL=sqlite:///./data/app.db
# AUTH_REQUIRED=false  # default: no login/signup, the app runs as a single local user.
#                       # Set true only if you're hosting one instance for more than one person.
# COOKIE_SECURE=false   # set true once served over HTTPS (only matters when AUTH_REQUIRED=true)

# --- SnapTrade (brokerage linking) ---
# Get these from your SnapTrade dashboard's API keys page.
# SNAPTRADE_CLIENT_ID=
# SNAPTRADE_CONSUMER_KEY=
